<!-- EXPORT FEATURE: Print-friendly CSS styles for individual note -->

<style>
@media print {
  /* Hide everything */
  body * {
    visibility: hidden;
    margin: 0 !important;
  }

  /* Show only the note section */
  .note-item, .note-item * {
    visibility: visible;
  }

  /* Remove spacing and force note to top */
  .note-item {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 95% !important;
    height: auto !important;
    margin: 25px 20px 25px 25px !important;
    padding: 10px !important;
    break-inside: avoid;
    page-break-inside: avoid;
    background: #fff !important;
    border: 1px solid #ccc !important;
